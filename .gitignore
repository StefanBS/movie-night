# Compiled Go binaries
/backend/backend

# Go test / coverage output
*.test
*.out
coverage.out

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# OS / editor cruft
.DS_Store

# Code-scanning SARIF artifacts (generated by `just audit-sarif`)
*.sarif

# Stray root lockfile — mobile/ is the only Node project, so an npm run from
# the repo root just leaves an empty lockfile behind.
/package-lock.json
