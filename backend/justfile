set dotenv-load := true

# List all recipes
default:
    @just --list

# Start the postgres:18 container (detached)
db-up:
    docker compose up -d db

# Stop and remove the postgres container
db-down:
    docker compose down

# Destroy the postgres container and its data volume
db-reset:
    docker compose down -v

# Apply all goose migrations
migrate:
    go tool goose -dir migrations postgres "$DATABASE_URL" up

# Roll back the most recent goose migration
migrate-down:
    go tool goose -dir migrations postgres "$DATABASE_URL" down

# Load the dev seed (idempotent; NOT a migration). ON_ERROR_STOP makes a
# failing seed.sql exit non-zero instead of rolling back and reporting success.
seed:
    docker compose exec -T db psql -U movie -d movienight -v ON_ERROR_STOP=1 < seed.sql

# Reset the dev DB to exactly the seed: empty every table (reset.sql, except
# goose's version table), then load the seed, then the fixture if one is named
# (fixtures/<fixture>.sql, e.g. `just reseed tonight-planned`), with today's
# local date as its "tonight". The same reset as the dev-only POST /dev/reseed
# that each `just e2e` flow (mobile/) calls.
reseed fixture="":
    #!/usr/bin/env bash
    set -euo pipefail
    files=(reset.sql seed.sql)
    [[ -z "{{fixture}}" ]] || files+=("fixtures/{{fixture}}.sql")
    cat "${files[@]}" | docker compose exec -T -e PGOPTIONS="-c fixture.today=$(date +%F)" \
        db psql -U movie -d movienight -v ON_ERROR_STOP=1 -q

# Regenerate the sqlc db package
sqlc:
    go tool sqlc generate

# Verify formatting with gofmt
fmt-check:
    test -z "$(gofmt -l .)" || { echo "Not gofmt-clean:"; gofmt -l .; exit 1; }

# Report suspicious constructs, in both the release build and the dev build
# (-tags dev adds devreset.go's POST /dev/reseed)
vet:
    go vet ./...
    go vet -tags dev ./...

# Compile all packages, as the release build (no dev routes) and the dev build
build:
    go build ./...
    go build -tags dev ./...

# Run the fast unit tests, in the release build (which proves it has no
# POST /dev/reseed)
test:
    go test ./...

# Run all fast checks: formatting, vet, build, unit tests (what CI runs)
check: fmt-check vet build test

# Run the testcontainers integration tests, in the dev build so the
# POST /dev/reseed tests run too
test-integration:
    go test -tags=integration,dev ./...

# The security scans read the dev build: everything the release build has, plus
# devreset.go.
scan_tags := "dev"

# Scan dependencies for known vulnerabilities (reachable-only, near-zero false positives)
vuln:
    go tool govulncheck -tags {{scan_tags}} ./...

# gosec is a go tool in its own module (tools/gosec/go.mod) so its heavy autofix
# deps stay out of backend/go.mod; Dependabot bumps it like any other go dep.
gosec := "go tool -modfile=tools/gosec/go.mod gosec"

# Static security analysis (skips sqlc-generated files)
sast:
    {{gosec}} -exclude-generated -tags {{scan_tags}} ./...

# Run all security scans, human-readable; fails if either scan does.
audit:
    #!/usr/bin/env bash
    # Both always run — a govulncheck failure must not mask gosec findings.
    set -uo pipefail
    rc=0
    just vuln || rc=1
    just sast || rc=1
    exit $rc

# Emit SARIF for the code-scanning upload AND gate it, each from a single scan run.
audit-sarif:
    #!/usr/bin/env bash
    # CI uploads the SARIF with `if: always()`, so findings still reach the Security
    # tab when this fails. gosec gates by exit code; govulncheck's SARIF mode always
    # exits 0, so gate on any reachable (error-level) finding — what text mode exits 3 for.
    set -uo pipefail
    rc=0
    {{gosec}} -exclude-generated -tags {{scan_tags}} -fmt sarif -out gosec.sarif ./... || rc=1
    go tool govulncheck -tags {{scan_tags}} -format sarif ./... > govulncheck.sarif || rc=1
    n=$(jq '[.runs[].results[] | select(.level == "error")] | length' govulncheck.sarif 2>/dev/null || echo 0)
    if [ "${n:-0}" -gt 0 ]; then
        echo "govulncheck: reachable vulnerabilities found (see govulncheck.sarif)" >&2
        rc=1
    fi
    exit $rc

# Run the backend server, as the dev build: with DEV_RESET=1 (.env) it serves
# the e2e flows' POST /dev/reseed. A release build leaves out -tags dev.
run:
    go run -tags dev .
