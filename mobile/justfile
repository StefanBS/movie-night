# List all recipes
default:
    @just --list

# Install dependencies
install:
    npm install

# Start the Metro dev server (connects to the installed dev client when present)
start:
    npm start

# Restart Metro with a cleared cache (fixes a phone stuck on a stale bundle)
start-clean:
    npx expo start -c

# Build/install the Android development client and start Metro
# Requires ANDROID_HOME, a JDK 21 (Android Studio JBR is fine), and adb device/emulator
android:
    npm run android

# Regenerate the Android native project (CNG; android/ is gitignored)
prebuild:
    npx expo prebuild --platform android

# Delete android/ and rebuild from scratch (use after SDK bumps or corrupt native/NDK installs)
android-clean:
    rm -rf android
    npm run android

# Render the PNG icons and splash images from the brand SVGs in assets/brand/
# (needs Inkscape and ImageMagick). Re-run after refreshing the SVGs from
# docs/design-system/assets/, then rebuild the dev client: they're native.
icons:
    #!/usr/bin/env bash
    set -euo pipefail
    b=assets/brand
    render() { inkscape "$1" --export-width="$2" --export-height="$2" --export-filename="$3"; }
    render $b/app-icon.svg 1024 assets/icon.png
    magick assets/icon.png -alpha off -define png:exclude-chunks=date,time assets/icon.png # iOS rejects icons with alpha
    render $b/app-icon.svg 48 assets/favicon.png
    render $b/app-icon-foreground.svg 1024 assets/android-icon-foreground.png
    # Monochrome (Android 13+ themed icon): the single-ink mark on the
    # foreground's canvas and scale. app-icon-foreground.svg draws the 32-unit
    # mark at scale(13), so a 416px mark centred on 1024 lines up exactly.
    render $b/logomark-mono.svg 416 assets/android-icon-monochrome.png
    magick assets/android-icon-monochrome.png -background none -gravity center -extent 1024x1024 -define png:exclude-chunks=date,time assets/android-icon-monochrome.png
    render $b/logomark.svg 1024 assets/splash-icon.png
    render $b/logomark-light.svg 1024 assets/splash-icon-light.png

# Launch on the iOS simulator (macOS only)
ios:
    npm run ios

# Launch in a web browser
web:
    npm run web

# Lint with eslint-config-expo
lint:
    npm run lint

# Type-check without emitting
typecheck:
    npx tsc --noEmit

# Run the unit + integration tests
test:
    npm test

# Verify every dep matches the Expo SDK compatibility matrix
# (bundledNativeModules.json). Catches drift off the matrix — which lint,
# typecheck and tests can't see, because none of them touch the native layer.
# Fix with `npx expo install --fix`. Also checks that Dependabot's ignore list
# holds every matrix package at its tier, so a newly added Expo-governed dep
# can't be bumped off the matrix by a bot PR.
check-deps:
    npx expo install --check
    node --import tsx scripts/check-dependabot-holds.ts

# Run everything CI runs: lint, type-check, tests, dep matrix
check: lint typecheck test check-deps

# Scan npm dependencies for known vulnerabilities (ignores in osv-scanner.toml)
audit:
    osv-scanner scan source --lockfile=package-lock.json --config=osv-scanner.toml

# osv-scanner exits non-zero on findings regardless of format; CI uploads the
# SARIF with `if: always()`, so findings still reach the Security tab on failure.
# Emit SARIF for the code-scanning upload AND gate it, in a single scan run.
audit-sarif:
    osv-scanner scan source --lockfile=package-lock.json --config=osv-scanner.toml --format sarif > osv-scanner.sarif

# Drive the dev client on the adb-attached phone: launch [port] | tap "<text>" |
# dump | shot <file> | has <text> (is my change in the phone's bundle?) |
# devlink [port]
[positional-arguments]
phone *args:
    bash scripts/phone.sh "$@"

# Run the Maestro end-to-end suite (.maestro/) on the adb-attached phone.
# <marker> is text from your change: the run refuses a phone whose bundle lacks
# it (`just phone has`). Each flow starts from a reseeded dev DB (needs the
# backend's Postgres up, and the backend + Metro running). Run a subset by
# naming flow files: just e2e "<marker>" .maestro/plan-night.yaml
[positional-arguments]
e2e marker *flows:
    #!/usr/bin/env bash
    set -euo pipefail
    export MAESTRO_CLI_NO_ANALYTICS=1 MAESTRO_CLI_ANALYSIS_NOTIFICATION_DISABLED=true
    command -v maestro >/dev/null || { echo "e2e: maestro isn't on PATH (see README: End-to-end tests)" >&2; exit 2; }
    marker=$1
    shift
    flows=("$@")
    [[ ${#flows[@]} -gt 0 ]] || flows=(.maestro/*.yaml)
    bash scripts/phone.sh launch
    bash scripts/phone.sh has "$marker"
    link=$(bash scripts/phone.sh devlink)
    app_id=$(node -p 'require("./app.json").expo.android.package')
    failed=()
    report() { [[ ${#failed[@]} -eq 0 ]] || printf 'e2e: FAILED %s\n' "${failed[@]}" >&2; }
    for f in "${flows[@]}"; do
        # A failed reseed stops the run, but still reports the flows before it.
        (cd ../backend && just reseed) || { report; echo "e2e: reseed failed before $f" >&2; exit 1; }
        maestro test -e APP_ID="$app_id" -e DEV_LINK="$link" "$f" || failed+=("$f")
    done
    if [[ ${#failed[@]} -gt 0 ]]; then
        report
        exit 1
    fi
    echo "e2e: all ${#flows[@]} flows passed" >&2
