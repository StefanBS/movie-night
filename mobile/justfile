# List all recipes
default:
    @just --list

# Install dependencies
install:
    npm install

# Start the Metro dev server (connects to the installed dev client when present)
start:
    npm start

# Restart Metro with a cleared cache (fixes a phone stuck on a stale bundle)
start-clean:
    npx expo start -c

# Build/install the Android development client and start Metro
# Requires ANDROID_HOME, a JDK 21 (Android Studio JBR is fine), and adb device/emulator
android:
    npm run android

# Regenerate the Android native project (CNG; android/ is gitignored)
prebuild:
    npx expo prebuild --platform android

# Delete android/ and rebuild from scratch (use after SDK bumps or corrupt native/NDK installs)
android-clean:
    rm -rf android
    npm run android

# Launch on the iOS simulator (macOS only)
ios:
    npm run ios

# Launch in a web browser
web:
    npm run web

# Lint with eslint-config-expo
lint:
    npm run lint

# Type-check without emitting
typecheck:
    npx tsc --noEmit

# Run the unit + integration tests
test:
    npm test

# Run everything CI runs: lint, type-check, tests
check: lint typecheck test

# Scan npm dependencies for known vulnerabilities (ignores in osv-scanner.toml)
audit:
    osv-scanner scan source --lockfile=package-lock.json --config=osv-scanner.toml

# osv-scanner exits non-zero on findings regardless of format; CI uploads the
# SARIF with `if: always()`, so findings still reach the Security tab on failure.
# Emit SARIF for the code-scanning upload AND gate it, in a single scan run.
audit-sarif:
    osv-scanner scan source --lockfile=package-lock.json --config=osv-scanner.toml --format sarif > osv-scanner.sarif
